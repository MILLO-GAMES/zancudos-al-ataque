{
  "name": "zancudos-al-ataque",
  "version": "1.0.0",
  "private": true,
  "description": "Zancudos al Ataque — juego AR de pieza. MILLO GAMES.",
  "author": "MILLO GAMES",
  "license": "SEE LICENSE IN vendor/mediapipe y assets/fonts/OFL.txt",
  "scripts": {
    "build": "node scripts/build-www.mjs",
